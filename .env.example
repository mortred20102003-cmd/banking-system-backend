# =========================================================
# Banking_System - Environment Variables (EXAMPLE)
# Copy to ".env" and fill in real values.
# NEVER commit the real ".env" file.
# =========================================================

# --- Database ---
DB_URL=jdbc:mysql://localhost:3306/banking_system_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# --- Server ---
SERVER_PORT=8080

# --- JWT ---
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
JWT_EXPIRATION_MS=3600000

# --- SuperAdmin (seeded once at startup) ---
SUPER_ADMIN_USERNAME=MikeyD
SUPER_ADMIN_EMAIL=mikeyD@bank.com
SUPER_ADMIN_PASSWORD=change_this_to_a_strong_password

# --- Account number generation ---
ACCOUNT_NUMBER_PREFIX=10
ACCOUNT_NUMBER_LENGTH=10

# --- Flyway ---
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true
